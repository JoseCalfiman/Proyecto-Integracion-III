# variables de entorno minimas para el proyecto de integración III

# BASE DE DATOS (TimescaleDB / PostgreSQL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=frigorifico

DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=frigorifico
DB_USER=admin
DB_PASSWORD=cambia_esta_contrasena

# MQTT (Mosquitto)
MQTT_HOST_LOCAL=localhost
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

MQTT_ESP32_USER=esp32
MQTT_ESP32_PASSWORD=cambia_esta_contraseña

MQTT_INGESTA_USER=ingesta
MQTT_INGESTA_PASSWORD=cambia_esta_contraseña

MQTT_ADMIN_USER=admin
MQTT_ADMIN_PASSWORD=cambia_esta_contraseña

# KAFKA
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Variables de entorno - Smart Fridge Monitoring
# Copia este archivo a ".env" y ajusta los valores:
#     cp .env.example .env
# El archivo .env NO se versiona (esta en .gitignore).
# ============================================================

# ---------- Base de datos (TimescaleDB / PostgreSQL) ----------
# Deben coincidir con database/init.sql y database/seeds.sql
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=frigorifico

# ---------- MQTT (Mosquitto) ----------
# Usuarios definidos en mosquitto/acl.conf (esp32 / ingesta / admin).
# Las contrasenas deben coincidir con las generadas en mosquitto/pwfile.
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USER=ingesta
MQTT_PASSWORD=cambia_esta_clave
MQTT_ADMIN_USER=admin
MQTT_ADMIN_PASSWORD=cambia_esta_clave
MQTT_ESP32_USER=esp32
MQTT_ESP32_PASSWORD=cambia_esta_clave

# Broker desde el PC (script de simulacion que corre fuera de Docker)
MQTT_HOST_LOCAL=localhost

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=sensor.raw
KAFKA_REPORT_TOPIC=optimization.reports
KAFKA_GROUP_ID=worker-optimizacion

# ---------- Acceso a la base de datos desde los microservicios ----------
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=frigorifico
DB_USER=admin
DB_PASSWORD=admin123
DB_PASS=admin123

# URL completa (la usan ingesta y worker-haccp)
DATABASE_URL=postgresql+psycopg2://admin:admin123@timescaledb:5432/frigorifico

# ---------- Worker de optimizacion ----------
# Ejecuta una optimizacion al iniciar (activado en el Deployment de demo).
OPTIMIZATION_RUN_ON_START=false
# OJO: los workers usan UUID para camara/empresa segun init.sql.
# Valores de ejemplo tomados de database/seeds.sql.
OPTIMIZATION_CHAMBER_ID=44444444-4444-4444-4444-444444444444
OPTIMIZATION_COMPANY_ID=11111111-1111-1111-1111-111111111111
# El precio se lee de energy_price (ultimo id_price/price_kwh por queried_at).
PRECIO_CNE_CSV=precio_cne.csv

# ---------- Dashboard (se inyecta en build, opcional) ----------
# Si se deja vacio, el frontend usa /api/v1 a traves de Nginx.
VITE_API_URL=/api/v1
